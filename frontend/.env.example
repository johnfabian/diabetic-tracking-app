# Copy to frontend/.env to override. Everything is optional in development —
# the Vite dev server proxies /api to the backend for you.

# Where the dev-server proxy forwards /api requests (the FastAPI backend).
#VITE_API_PROXY=http://127.0.0.1:8000

# Base URL prepended to every API call by the browser. Leave unset to use
# relative URLs (same origin / dev proxy). Set it when the built frontend is
# served from a different host than the API.
#VITE_API_BASE_URL=http://127.0.0.1:8000

# Dev server port.
#VITE_DEV_PORT=5173
