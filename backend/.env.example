# Copy to backend/.env and edit. Everything is optional — defaults run
# against the bundled PGlite database with the Anthropic vision provider.

# ── Database ─────────────────────────────────────────────────────────
# Default is the PGlite sidecar (started by `npm run dev`).
# To use a real Postgres instead, set any standard DSN and raise the pool:
#DATABASE_URL=postgresql://user:password@localhost:5432/glucolog
#DB_MAX_CONNECTIONS=10
# NOTE: keep DB_MAX_CONNECTIONS=1 (the default) while on PGlite — it only
# accepts a single client connection. With a real Postgres you can also skip
# the sidecar: run `npm run dev:api` + `npm run dev:web` instead of `npm run dev`.

# ── API ──────────────────────────────────────────────────────────────
# Browser origins allowed by CORS (comma-separated). Add your LAN address
# here if you open the app from your phone, e.g. http://192.168.1.20:5173
#CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Vision provider ──────────────────────────────────────────────────
# Option A (default): Anthropic
#VISION_PROVIDER=anthropic
#ANTHROPIC_API_KEY=sk-ant-...
#VISION_MODEL=claude-opus-4-8
# Cheaper Anthropic option:
#VISION_MODEL=claude-haiku-4-5

# Option B: any OpenAI-compatible endpoint (local or hosted)
#VISION_PROVIDER=openai

# … local Ollama (free, runs on your machine — `ollama pull qwen2.5vl:7b`):
#OPENAI_BASE_URL=http://localhost:11434/v1
#OPENAI_API_KEY=ollama
#VISION_MODEL=qwen2.5vl:7b

# … LM Studio:
#OPENAI_BASE_URL=http://localhost:1234/v1
#OPENAI_API_KEY=lm-studio
#VISION_MODEL=your-loaded-model

# … OpenRouter (many cheap hosted vision models):
#OPENAI_BASE_URL=https://openrouter.ai/api/v1
#OPENAI_API_KEY=sk-or-...
#VISION_MODEL=google/gemini-2.0-flash-001

# … OpenAI:
#OPENAI_API_KEY=sk-...
#VISION_MODEL=gpt-4o-mini
